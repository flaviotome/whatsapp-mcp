{
  "name": "whatsapp-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "WhatsApp MCP server (Python + wacli) with an admin panel, running in Docker",
  "scripts": {
    "start": "docker compose up -d",
    "stop": "docker compose down",
    "logs": "docker compose logs -f whatsapp-mcp",
    "token": "docker compose exec -T whatsapp-mcp cat /data/auth_token",
    "password": "docker compose exec -T whatsapp-mcp cat /data/admin_password",
    "status": "node scripts/status.mjs",
    "qr": "node scripts/status.mjs --open",
    "dev": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d --build",
    "inspector": "npx -y @modelcontextprotocol/inspector",
    "test": "python -m pytest -q",
    "reset": "docker compose down -v"
  },
  "engines": {
    "node": ">=18"
  }
}
