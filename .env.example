# Optional settings. Copy to .env next to docker-compose.yml and adjust; every variable has a default.

# Image tag to run (latest, or a release such as 0.1.0)
WHATSAPP_MCP_VERSION=latest

# Host port, bound to 127.0.0.1 only (reach it through an SSH tunnel from another machine)
HOST_PORT=8000

# Fixed bearer token. Leave empty to auto-generate one on first start
# (shown in `docker compose logs whatsapp-mcp`, stored in the data volume).
MCP_AUTH_TOKEN=

# Public HTTPS (optional): a domain whose DNS points to this machine, ports 80/443 open.
# Start with: docker compose --profile https up -d
DOMAIN=

# Extra accepted Host headers (hostnames, comma separated). DOMAIN is added automatically.
ALLOWED_HOSTS=localhost,127.0.0.1

# Pair with an 8-character code instead of the QR code (international number, digits only, e.g. 5511999998888)
WA_PAIR_PHONE=

# quiet = phone notifications stay audible while linked; normal = this device appears online
WA_PRESENCE_MODE=quiet

# Optional caps on local history growth
WACLI_SYNC_MAX_MESSAGES=
WACLI_SYNC_MAX_DB_SIZE=

# Images are downloaded on demand, when an agent opens one. Optionally, download every
# image from the last N days in the background before WhatsApp's servers expire them
# (uses disk and bandwidth for images nobody may open). Cache size cap in MB.
MEDIA_PREFETCH_DAYS=0
MEDIA_CACHE_MAX_MB=1024

TZ=America/Sao_Paulo
